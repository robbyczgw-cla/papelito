%%{init: {"theme":"base","themeVariables":{"fontFamily":"Helvetica, Arial, sans-serif","fontSize":"17px","primaryTextColor":"#111111","lineColor":"#4a4a4a","clusterBkg":"#ffffff","clusterBorder":"#8a8a8a"},"flowchart":{"nodeSpacing":40,"rankSpacing":50,"curve":"basis","padding":14}}}%%
flowchart TB
    subgraph H["Household host: your own machine"]
        UI["FastAPI PWA + CLI<br/>photo in, results out"]
        AGENT["Strands agent<br/>SDK is a library, not a hosted AWS service<br/>model → tools → reasoning loop"]
        TOOLS["Tools: create case, write .ics,<br/>draft reply, explain"]
        DB[("SQLite case file")]
        OUT["English card<br/>German reply: copied, never sent<br/>.ics event with VALARM -48 h"]
        WD["Daily systemd watchdog<br/>reads SQLite, flags reminders<br/>no model by default"]
        PRESET["PWA preset-text route<br/>separate path, no local agent"]
    end
    subgraph X["External services"]
        ZEN["Zen model provider<br/>vision + text"]
        MCP["Web Search Plus MCP<br/>redacted office lookup"]
        AC["AgentCore Runtime, private, eu-central-1<br/>IAM SigV4 only<br/>extraction / explanation card only<br/>no calendar, no reply, no reminders"]
    end
    subgraph J["Judge sandbox"]
        LS["Lightsail VM behind HTTPS distribution<br/>same PWA + SQLite + systemd<br/>synthetic data only, AgentCore disabled"]
    end
    UI -- "photo" --> AGENT
    AGENT -- "tool calls" --> TOOLS
    TOOLS -- "save case" --> DB
    TOOLS --> OUT
    OUT -- "shown" --> UI
    WD -- "due cases" --> DB
    WD -- "reminders" --> UI
    AGENT <-- "vision + text calls" --> ZEN
    TOOLS -- "office name only, no PII" --> MCP
    PRESET -- "SigV4 request, preset text" --> AC
    AC -- "card" --> PRESET
    AC -- "model calls" --> ZEN
    LS -- "model calls" --> ZEN
    classDef n1 fill:#e8f0fe,stroke:#3a5a9b,stroke-width:1.5px,color:#111111
    classDef n2 fill:#e6f6ec,stroke:#2f7a4d,stroke-width:1.5px,color:#111111
    classDef n3 fill:#fdf2dc,stroke:#9a7226,stroke-width:1.5px,color:#111111
    classDef n4 fill:#fdeceb,stroke:#a4453d,stroke-width:1.5px,color:#111111
    classDef n5 fill:#efe9fb,stroke:#5f4a9b,stroke-width:1.5px,color:#111111
    class UI,PRESET,WD n1
    class AGENT n2
    class TOOLS,DB,OUT n3
    class ZEN,MCP,AC n4
    class LS n5
